# Copiar este archivo como .env y reemplazar el valor por una clave aleatoria
# de al menos 32 bytes. Nunca versionar el archivo .env real.
JWT_SECRET=reemplazar-por-una-clave-aleatoria-de-al-menos-32-bytes

# Opcionales: permiten crear el primer administrador al iniciar la aplicacion.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=reemplazar-por-una-contrasena-segura

# Requeridas por docker-compose (el backend no arranca sin ellas).
# API key de WeatherAPI.com (plan con forecast de 14 dias).
WEATHERAPI_API_KEY=reemplazar-por-la-api-key-de-weatherapi
# Token que entrega @BotFather al crear el bot, y su username (sin la @).
TELEGRAM_BOT_TOKEN=reemplazar-por-el-token-de-botfather
TELEGRAM_BOT_USERNAME=reemplazar-por-el-username-del-bot
