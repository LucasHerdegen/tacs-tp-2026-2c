# Copiar este archivo como .env y reemplazar el valor por una clave aleatoria
# de al menos 32 bytes. Nunca versionar el archivo .env real.
JWT_SECRET=reemplazar-por-una-clave-aleatoria-de-al-menos-32-bytes

# Opcionales: permiten crear el primer administrador al iniciar la aplicacion.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=reemplazar-por-una-contrasena-segura

# Requeridas por docker-compose (el backend no arranca sin ellas).
# API key de WeatherAPI.com (plan con forecast de 14 dias).
WEATHERAPI_API_KEY=reemplazar-por-la-api-key-de-weatherapi
# Token que entrega @BotFather al crear el bot, y su username (sin la @).
TELEGRAM_BOT_TOKEN=reemplazar-por-el-token-de-botfather
TELEGRAM_BOT_USERNAME=reemplazar-por-el-username-del-bot

# --- Proveedor de clima legacy (Humedad, Datos y Pronosticos S.A.) ---
# 1. Ejecutar una sola vez el binario del proveedor legacy en tu maquina local
#    (Windows: .\bin\bin\tacs-windows-amd64.exe | Linux: descomprimir legacy-clima/tacs-linux-amd64.gz)
#    e iniciar sesion con Google usando una cuenta institucional @frba.utn.edu.ar.
# 2. Copiar el API token impreso en consola en LEGACY_CLIMA_API_TOKEN.
# 3. Copiar el archivo token.json generado por el binario a legacy-clima/secrets/token.json
#    (Windows: %APPDATA%\tacs\token.json | Linux: ~/.config/tacs/token.json | macOS: ~/Library/Application Support/tacs/token.json).
#    Alternativamente, descomentar LEGACY_CLIMA_TOKEN_DIR apuntando a la carpeta de token.json,
#    o definir LEGACY_CLIMA_TOKEN_JSON con el JSON completo (para despliegues en la nube sin volumenes).
# Nunca versionar .env, LEGACY_CLIMA_API_TOKEN ni token.json en Git.
LEGACY_CLIMA_API_TOKEN=reemplazar-por-el-api-token-emitido-por-el-binario
LEGACY_CLIMA_BASE_URL=http://clima-legacy:9978
# LEGACY_CLIMA_TOKEN_DIR=./legacy-clima/secrets
# LEGACY_CLIMA_TOKEN_JSON=

# --- Observabilidad (TP5) ---
# Puerto expuesto del backend en el host (opcional, útil si 8080 está ocupado localmente).
# BACKEND_PORT=8080
# Demora controlada opcional en milisegundos sobre la consulta de búsqueda (0 = deshabilitada).
OBSERVABILIDAD_BUSQUEDA_DEMORA_MS=0
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
